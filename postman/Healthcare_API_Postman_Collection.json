{
  "info": {
    "name": "Healthcare API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET all patients",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/patients" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Status code is 200\", function () {",
        "    pm.response.to.have.status(200);",
        "});",
        "pm.test(\"Response is an array\", function () {",
        "    pm.expect(pm.response.json()).to.be.an(\"array\");",
        "});"
      ]}}]
    },
    {
      "name": "POST new patient",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Marie\",\n  \"age\": 29\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/patients"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Status code is 201\", function () {",
        "    pm.response.to.have.status(201);",
        "});",
        "pm.test(\"Patient has an id\", function () {",
        "    const body = pm.response.json();",
        "    pm.expect(body).to.have.property(\"id\");",
        "    pm.expect(body.name).to.eql(\"Marie\");",
        "});"
      ]}}]
    },
    {
      "name": "POST patient - missing fields (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Paul\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/patients"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test(\"Status code is 400\", function () {",
        "    pm.response.to.have.status(400);",
        "});"
      ]}}]
    }
  ]
}
